{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MojoRecomp Launcher",
  "version": "1.0.0",
  "identifier": "com.mojorecomp.launcher",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run prepare:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MojoRecomp Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "maximized": true,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}

+
+void Recompiler::AnalyseContextLocalSafety()
+{
+    contextUnsafeFunctions.clear();
+
+    if (config.contextBarrierFunctions.empty() ||
+        (!config.crRegistersAsLocalVariables && !config.nonVolatileRegistersAsLocalVariables))
+    {
+        return;
+    }
+
+    std::unordered_set<uint32_t> guestFunctions;
+    guestFunctions.reserve(functions.size());
+    for (const auto& fn : functions)
+        guestFunctions.emplace(static_cast<uint32_t>(fn.base));
+
+    std::unordered_map<uint32_t, std::vector<uint32_t>> callers;
+    callers.reserve(functions.size());
+    std::vector<uint32_t> pending;
+    pending.reserve(functions.size());
+
+    auto markUnsafe = [&](uint32_t address)
+    {
+        if (contextUnsafeFunctions.emplace(address).second)
+            pending.push_back(address);
+    };
+
+    auto isSaveRestoreHelper = [&](uint32_t address)
+    {
+        auto symbol = image.symbols.find(address);
+        if (symbol == image.symbols.end() || symbol->address != address || symbol->type != Symbol_Function)
+            return false;
+        return symbol->name.find("__save") == 0 || symbol->name.find("__rest") == 0;
+    };
+
+    for (uint32_t barrier : config.contextBarrierFunctions)
+        markUnsafe(barrier);
+
+    for (const auto& fn : functions)
+    {
+        const uint32_t fnBase = static_cast<uint32_t>(fn.base);
+        const uint32_t fnEnd = fnBase + static_cast<uint32_t>(fn.size);
+        auto symbol = image.symbols.find(fnBase);
+        if (symbol != image.symbols.end() && symbol->address == fnBase && symbol->type == Symbol_Function &&
+            (symbol->name.find("__save") == 0 || symbol->name.find("__rest") == 0))
+        {
+            // Unsafe callers keep these helpers, so the helpers themselves must
+            // continue to operate on PPCContext-backed non-volatile registers.
+            markUnsafe(fnBase);
+        }
+
+        const auto* data = static_cast<const uint32_t*>(image.Find(fnBase));
+        if (!data)
+        {
+            markUnsafe(fnBase);
+            continue;
+        }
+
+        for (uint32_t address = fnBase; address < fnEnd; address += 4)
+        {
+            const uint32_t instruction = ByteSwap(data[(address - fnBase) / 4]);
+            const uint32_t op = PPC_OP(instruction);
+            const bool link = PPC_BL(instruction) != 0;
+
+            // Mid-asm hooks cross into host code. Keep context-sensitive locals
+            // out of those functions unless a future hook-specific contract says
+            // that the hook cannot re-enter guest execution.
+            if (config.midAsmHooks.find(address) != config.midAsmHooks.end())
+                markUnsafe(fnBase);
+
+            bool directBranch = false;
+            uint32_t target = 0;
+            if (op == PPC_OP_B)
+            {
+                const int32_t displacement = PPC_BI(instruction);
+                target = PPC_BA(instruction) ? static_cast<uint32_t>(displacement)
+                                             : address + displacement;
+                directBranch = true;
+            }
+            else if (op == PPC_OP_BC)
+            {
+                const int32_t displacement = PPC_BD(instruction);
+                target = PPC_BA(instruction) ? static_cast<uint32_t>(displacement)
+                                             : address + displacement;
+                directBranch = true;
+            }
+
+            if (directBranch)
+            {
+                const bool leavesFunction = target < fnBase || target >= fnEnd;
+                if (link || leavesFunction)
+                {
+                    // When non-volatile locals are enabled these ABI save/restore
+                    // calls are omitted in context-safe functions, so they must
+                    // not poison the reverse call graph.
+                    if (config.nonVolatileRegistersAsLocalVariables && isSaveRestoreHelper(target))
+                        continue;
+
+                    if (guestFunctions.find(target) != guestFunctions.end())
+                        callers[target].push_back(fnBase);
+                    else
+                        markUnsafe(fnBase); // host/import/unknown direct target
+                }
+                continue;
+            }
+
+            if (op == PPC_OP_CTR)
+            {
+                const uint32_t xop = PPC_XOP(instruction);
+                if (xop == 528)
+                {
+                    // A known switch table is intra-function control flow. Any
+                    // other branch-through-CTR can invoke an arbitrary guest or
+                    // host target, so keep the active frame context-backed.
+                    if (config.switchTables.find(address) == config.switchTables.end())
+                        markUnsafe(fnBase);
+                }
+                else if (xop == 16 && link)
+                {
+                    markUnsafe(fnBase);
+                }
+            }
+        }
+    }
+
+    for (size_t i = 0; i < pending.size(); ++i)
+    {
+        auto it = callers.find(pending[i]);
+        if (it == callers.end())
+            continue;
+        for (uint32_t caller : it->second)
+            markUnsafe(caller);
+    }
+
+    fmt::println("Context-safe register localization: {} safe, {} context-backed",
+        functions.size() - contextUnsafeFunctions.size(), contextUnsafeFunctions.size());
 }

